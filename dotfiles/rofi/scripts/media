#!/usr/bin/env bash
# Requires: playerctl

if ! command -v playerctl &>/dev/null; then
    rofi -e "media: install playerctl"
    exit 1
fi

prompt=$(playerctl metadata --format "{{artist}}{{artist:+ - }}{{title}} [{{status}}]" 2>/dev/null \
    || echo "nothing playing [stopped]")

chosen=$(printf "play/pause\nnext\nprevious\nstop" \
    | rofi -dmenu -p "$prompt" -config ~/.config/rofi/config.rasi)

[ -z "$chosen" ] && exec rofi -show combi -config ~/.config/rofi/config.rasi -filter "${ROFI_PARENT_ITEM:-}"

case "$chosen" in
    "play/pause") playerctl play-pause ;;
    "next")       playerctl next ;;
    "previous")   playerctl previous ;;
    "stop")       playerctl stop ;;
esac
