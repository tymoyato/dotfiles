#!/usr/bin/env bash
# Requires: easyeffects

if ! command -v easyeffects &>/dev/null; then
    rofi -e "easyeffects: not installed"
    exit 1
fi

PRESETS_DIR="$HOME/.local/share/easyeffects/output"

chosen=$(printf "open gui\ntoggle\n$(ls "$PRESETS_DIR" 2>/dev/null | sed 's/\.json$//')" \
    | rofi -dmenu -p "easyeffects" -config ~/.config/rofi/config.rasi)

[ -z "$chosen" ] && exec rofi -show combi -config ~/.config/rofi/config.rasi -filter "${ROFI_PARENT_ITEM:-}"

case "$chosen" in
    "open gui")  easyeffects & ;;
    "toggle")    easyeffects --gapplication-service & ;;
    *)           easyeffects --load-preset "$chosen" ;;
esac
